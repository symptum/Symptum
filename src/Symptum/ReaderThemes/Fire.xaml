<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="MarkdownBackground" Color="#1A0F0A" />
      <SolidColorBrush x:Key="MarkdownForeground" Color="#F5E0D2" />
      <SolidColorBrush x:Key="MarkdownAccentText" Color="#F2673D" />
      <SolidColorBrush x:Key="MarkdownAccentFill" Color="#F2673D" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="MarkdownBackground" Color="#FFF8F3" />
      <SolidColorBrush x:Key="MarkdownForeground" Color="#2E1408" />
      <SolidColorBrush x:Key="MarkdownAccentText" Color="#D9A81C" />
      <SolidColorBrush x:Key="MarkdownAccentFill" Color="#D9A81C" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
