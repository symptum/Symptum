<local:NavigablePage x:Class="Symptum.Pages.FocusSessionPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="using:Symptum.Pages"
                     xmlns:ui="using:Symptum.UI"
                     xmlns:controls="using:CommunityToolkit.WinUI.Controls"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d">
  <local:NavigablePage.Resources>
    <RadialGradientBrush x:Key="FocusVisualBrush">
      <GradientStop Color="#8FE63946" Offset="0.0" />
      <GradientStop Color="#00E63946" Offset="0.6" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ShortBreakVisualBrush">
      <GradientStop Color="#8F9ACD32" Offset="0.0" />
      <GradientStop Color="#009ACD32" Offset="0.6" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LongBreakVisualBrush">
      <GradientStop Color="#8F1E90FF" Offset="0.0" />
      <GradientStop Color="#001E90FF" Offset="0.6" />
    </RadialGradientBrush>

    <Storyboard x:Name="opacityAnimation">
      <DoubleAnimation From="0" To="1" Duration="00:00:02"
                   Storyboard.TargetName="visual" 
                   Storyboard.TargetProperty="Opacity">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseInOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation From="0" To="0.5" Duration="00:00:02"
                   Storyboard.TargetName="visual2" 
                   Storyboard.TargetProperty="Opacity">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseInOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Name="scaleAnimation" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation From="0.6" To="1" Duration="00:00:05"
                       Storyboard.TargetName="transform1" 
                       Storyboard.TargetProperty="ScaleY">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseInOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation From="0.6" To="1" Duration="00:00:05"
                       Storyboard.TargetName="transform1" 
                       Storyboard.TargetProperty="ScaleX">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseInOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation From="0.6" To="2" Duration="00:00:05"
                       Storyboard.TargetName="transform2"
                       Storyboard.TargetProperty="ScaleX">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseInOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation From="0.6" To="2" Duration="00:00:05"
                       Storyboard.TargetName="transform2"
                       Storyboard.TargetProperty="ScaleY">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseInOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </local:NavigablePage.Resources>

  <Grid x:Name="content"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RowSpacing="28"
        RowDefinitions="Auto,*,Auto">

    <Ellipse x:Name="visual"
             Grid.RowSpan="3"
             Opacity="0"
             HorizontalAlignment="Center"
             VerticalAlignment="Bottom"
             RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform>
        <ScaleTransform x:Name="transform1" ScaleX="0.6" ScaleY="0.6" />
      </Ellipse.RenderTransform>
    </Ellipse>

    <Grid x:Name="clockGrid"
          Grid.Row="1"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
      <Ellipse x:Name="visual2"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0"
               RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="transform2" ScaleX="0.6" ScaleY="0.6" />
          </TransformGroup>
        </Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="ringTrack"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.35"
               Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
      <Path x:Name="ringProgress"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round" />
      <TextBlock x:Name="timeTB"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontFamily="{ThemeResource MarkdownCodeFontFamily}"
                 FontSize="64"
                 FontWeight="SemiBold"
                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                 Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" />
    </Grid>

    <controls:Segmented x:Name="modeSegmented"
                        HorizontalAlignment="Center"
                        SelectionChanged="ModeSegmented_SelectionChanged">
      <controls:SegmentedItem Content="Focus" />
      <controls:SegmentedItem Content="Short Break" />
      <controls:SegmentedItem Content="Long Break" />
    </controls:Segmented>
    
    <StackPanel HorizontalAlignment="Center"
                Grid.Row="2"
                Orientation="Horizontal"
                Spacing="28">
      <Button x:Name="resetButton"
              Command="{x:Bind ViewModel.ResetCommand}"
              Style="{ThemeResource IconButtonStyle}"
              ToolTipService.ToolTip="Reset">
        <FontIcon FontSize="14" Glyph="{x:Bind ui:CommonGlyphs.Reset}" />
      </Button>
      <Button x:Name="playButton"
              Width="72"
              Height="72"
              Command="{x:Bind ViewModel.ToggleCommand}"
              CornerRadius="36"
              Style="{ThemeResource AccentButtonStyle}"
              ToolTipService.ToolTip="Start / Pause">
        <FontIcon x:Name="playIcon"
                  FontSize="26"
                  Glyph="{x:Bind ui:CommonGlyphs.Play}" />
      </Button>
      <Button x:Name="skipButton"
              Command="{x:Bind ViewModel.SkipCommand}"
              Style="{ThemeResource IconButtonStyle}"
              ToolTipService.ToolTip="Skip">
        <FontIcon FontSize="14" Glyph="{x:Bind ui:CommonGlyphs.Skip}" />
      </Button>
    </StackPanel>
  </Grid>
</local:NavigablePage>
