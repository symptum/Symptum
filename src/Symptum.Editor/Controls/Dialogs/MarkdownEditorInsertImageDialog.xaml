<ContentDialog
  x:Class="Symptum.Editor.Controls.MarkdownEditorInsertImageDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Symptum.Editor.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Style="{ThemeResource DefaultContentDialogStyle}"
  Title="Insert Image" PrimaryButtonText="Insert"
  CloseButtonText="Cancel" DefaultButton="Primary">
  <Grid RowDefinitions="Auto,*" RowSpacing="16">
    <SelectorBar x:Name="modeSelector" SelectionChanged="ModeSelector_SelectionChanged">
      <SelectorBarItem x:Name="onlineItem" Text="Online" IsSelected="True" />
      <SelectorBarItem x:Name="resourcesItem" Text="Resources" />
    </SelectorBar>

    <StackPanel x:Name="onlinePanel" Grid.Row="1" Spacing="8">
      <TextBox x:Name="urlTB" Header="URL" />
      <TextBox x:Name="altTB" Header="Alt Text" Grid.Row="1" />
      <TextBox x:Name="titleTB" Header="Title" Grid.Row="2" />
    </StackPanel>
    <ItemsView x:Name="resourcesView"
               Grid.Row="1"
               Visibility="Collapsed"
               SelectionMode="Multiple"
               ItemsSource="{x:Bind ResourceItems, Mode=OneWay}">
      <ItemsView.Layout>
        <UniformGridLayout Orientation="Horizontal"
                           MinItemWidth="120"
                           MinItemHeight="140"
                           MaximumRowsOrColumns="4"
                           ItemsJustification="SpaceEvenly" />
      </ItemsView.Layout>
      <ItemsView.ItemTemplate>
        <DataTemplate x:DataType="local:ImageResourceItem">
          <ItemContainer>
            <Grid RowSpacing="4" Padding="6">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                     Stretch="Uniform"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     MaxWidth="80" MaxHeight="80" />
              <TextBlock Grid.Row="1"
                         Text="{x:Bind Title}"
                         TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis"
                         TextAlignment="Center"
                         FontSize="12"
                         MaxLines="2" />
            </Grid>
          </ItemContainer>
        </DataTemplate>
      </ItemsView.ItemTemplate>
    </ItemsView>
  </Grid>
</ContentDialog>
