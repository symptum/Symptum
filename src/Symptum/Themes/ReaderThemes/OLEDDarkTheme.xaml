<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="MarkdownBackgroundBrush" Color="#FF000000" />
  <SolidColorBrush x:Key="MarkdownForegroundBrush" Color="#FFE0E0E0" />
  <SolidColorBrush x:Key="MarkdownAccentBrush" Color="#FFBB86FC" />
  <SolidColorBrush x:Key="MarkdownH1Foreground" Color="#FFBB86FC" />
  <SolidColorBrush x:Key="MarkdownCodeBackground" Color="#FF0D0D0D" />
  <SolidColorBrush x:Key="MarkdownCodeBorderBrush" Color="#FF333333" />
  <SolidColorBrush x:Key="MarkdownTableHeaderBackground" Color="#FFBB86FC" />
  <SolidColorBrush x:Key="MarkdownTableHeaderForeground" Color="#FF000000" />
  <SolidColorBrush x:Key="MarkdownTableBorderBrush" Color="#FF333333" />
  <SolidColorBrush x:Key="MarkdownTableAltBackground" Color="#FF0A0A0A" />
  <SolidColorBrush x:Key="MarkdownThematicBreakBrush" Color="#FF333333" />
  <SolidColorBrush x:Key="DefaultQuoteBackground" Color="#FF0D0D0D" />
  <SolidColorBrush x:Key="DefaultQuoteBorderBrush" Color="#FFBB86FC" />
  <SolidColorBrush x:Key="DefaultQuoteForeground" Color="#FFE0E0E0" />

</ResourceDictionary>
