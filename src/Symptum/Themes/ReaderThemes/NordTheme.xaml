<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="MarkdownBackgroundBrush" Color="#FF2E3440" />
  <SolidColorBrush x:Key="MarkdownForegroundBrush" Color="#FFD8DEE9" />
  <SolidColorBrush x:Key="MarkdownAccentBrush" Color="#FF88C0D0" />
  <SolidColorBrush x:Key="MarkdownH1Foreground" Color="#FF88C0D0" />
  <SolidColorBrush x:Key="MarkdownCodeBackground" Color="#FF3B4252" />
  <SolidColorBrush x:Key="MarkdownCodeBorderBrush" Color="#FF4C566A" />
  <SolidColorBrush x:Key="MarkdownTableHeaderBackground" Color="#FF88C0D0" />
