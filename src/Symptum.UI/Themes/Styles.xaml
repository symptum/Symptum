<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="using:Symptum.UI.Markdown"
                    xmlns:controls="using:Symptum.UI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Symptum.UI/Markdown/QuoteControl.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource DefaultAppBarButtonStyle}"
                TargetType="AppBarButton">
        <Setter Property="LabelPosition"
                    Value="Collapsed"/>
        <Setter Property="Width"
                    Value="48"/>
        <Setter Property="Height"
                    Value="48"/>
    </Style>
    <Style BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}"
                TargetType="AppBarToggleButton">
        <Setter Property="LabelPosition"
                    Value="Collapsed"/>
        <Setter Property="Width"
                    Value="48"/>
        <Setter Property="Height"
                    Value="48"/>
    </Style>
    <Style x:Key="StatusBarTextBlockStyle"
                TargetType="TextBlock"
                BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping"
                    Value="NoWrap"/>
        <Setter Property="VerticalAlignment"
                    Value="Center"/>
    </Style>
    <Style x:Key="IconButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding"
                    Value="4"/>
        <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
    </Style>
    <Style x:Key="IconToggleButtonStyle"
                TargetType="ToggleButton"
                BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Padding"
                    Value="4"/>
        <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
    </Style>


    <Style BasedOn="{StaticResource DefaultImageViewerStyle}"
         TargetType="controls:ImageViewer" />

    <Style x:Key="DefaultImageViewerStyle"
         TargetType="controls:ImageViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ImageViewer">
                    <Grid RowDefinitions="*,Auto">
                        <Grid.Resources>
                            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="DefaultState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="600" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState x:Name="MinimalState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="PART_ZoomCombo.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_ZoomSlider.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_ZoomOutButton.(Grid.Column)" Value="7" />
                                        <Setter Target="PART_ZoomOutButton.(Grid.ColumnSpan)" Value="2" />
                                        <Setter Target="PART_ZoomInButton.(Grid.Column)" Value="9" />
                                        <Setter Target="PART_ZoomInButton.(Grid.ColumnSpan)" Value="8" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        
                        <ScrollViewer x:Name="PART_ScrollViewer"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="PART_Image" Stretch="None" />
                        </ScrollViewer>

                        <Grid Grid.Row="1" ColumnSpacing="8" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PART_ActionButton" VerticalAlignment="Stretch">
                                <FontIcon x:Name="PART_ActionButtonIcon" Glyph="&#xE946;" FontSize="14" />
                            </Button>
                            <AppBarSeparator Grid.Column="1"/>
                            <TextBlock x:Name="PART_ResText" Grid.Column="2" Style="{ThemeResource StatusBarTextBlockStyle}" />
                            <AppBarSeparator Grid.Column="3"/>
                            <TextBlock x:Name="PART_SizeText" Grid.Column="4" Style="{ThemeResource StatusBarTextBlockStyle}" />
                            <AppBarSeparator Grid.Column="5"/>
                            <Button x:Name="PART_ZoomToFitButton" Grid.Column="6" VerticalAlignment="Stretch" ToolTipService.ToolTip="Zoom To Fit">
                                <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                            </Button>
                            <ComboBox x:Name="PART_ZoomCombo" Grid.Column="7" IsEditable="True" MinWidth="75" VerticalAlignment="Center" />
                            <RepeatButton x:Name="PART_ZoomOutButton" Grid.Column="8" VerticalAlignment="Stretch" ToolTipService.ToolTip="Zoom Out">
                                <FontIcon Glyph="&#xE71F;" FontSize="14" />
                            </RepeatButton>
                            <Slider x:Name="PART_ZoomSlider" Grid.Column="9" Minimum="10" Maximum="1000" VerticalAlignment="Center" MinWidth="130" />
                            <RepeatButton x:Name="PART_ZoomInButton" Grid.Column="10" VerticalAlignment="Stretch" ToolTipService.ToolTip="Zoom In">
                                <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                            </RepeatButton>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <StaticResource x:Key="MarkdownBackgroundBrush" ResourceKey="SolidBackgroundFillColorBaseBrush" />
    <StaticResource x:Key="MarkdownForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
    <StaticResource x:Key="MarkdownAccentBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
    <StaticResource x:Key="MarkdownH1Foreground" ResourceKey="AccentTextFillColorPrimaryBrush" />

    <StaticResource x:Key="MarkdownCodeBackground" ResourceKey="SolidBackgroundFillColorSecondaryBrush" />
    <StaticResource x:Key="MarkdownCodeBorderBrush" ResourceKey="ControlStrongStrokeColorDefaultBrush" />

    <StaticResource x:Key="MarkdownTableHeaderBackground" ResourceKey="AccentFillColorDefaultBrush" />
    <StaticResource x:Key="MarkdownTableHeaderForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
    <StaticResource x:Key="MarkdownTableBorderBrush" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
    <StaticResource x:Key="MarkdownTableAltBackground" ResourceKey="ControlAltFillColorQuarternaryBrush" />

    <StaticResource x:Key="MarkdownThematicBreakBrush" ResourceKey="ControlStrongStrokeColorDefaultBrush" />

    <StaticResource x:Key="MarkdownBodyFontFamily" ResourceKey="ContentControlThemeFontFamily" />
    <FontFamily x:Key="MarkdownCodeFontFamily">ms-appx:///Symptum.UI/Fonts/CascadiaCode-Regular.ttf#Cascadia Code</FontFamily>
    <x:Double x:Key="MarkdownBodyFontSize">14</x:Double>
    <x:Double x:Key="MarkdownH1FontSize">28</x:Double>
    <x:Double x:Key="MarkdownH2FontSize">24</x:Double>
    <x:Double x:Key="MarkdownH3FontSize">22</x:Double>
    <x:Double x:Key="MarkdownH4FontSize">20</x:Double>
    <x:Double x:Key="MarkdownH5FontSize">18</x:Double>
    <x:Double x:Key="MarkdownH6FontSize">16</x:Double>

    <Style x:Key="DefaultBodyTextBlockStyle"
         BasedOn="{StaticResource BodyTextBlockStyle}"
         TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MarkdownBodyFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource MarkdownBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource MarkdownForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalTextAlignment" Value="Left" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <Style x:Key="DefaultH1TextBlockStyle"
         BasedOn="{StaticResource DefaultBodyTextBlockStyle}"
         TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource MarkdownH1FontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource MarkdownH1Foreground}" />
    </Style>

    <Style x:Key="DefaultH2TextBlockStyle"
         BasedOn="{StaticResource DefaultBodyTextBlockStyle}"
         TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource MarkdownH2FontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="DefaultH3TextBlockStyle"
         BasedOn="{StaticResource DefaultBodyTextBlockStyle}"
         TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource MarkdownH3FontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="DefaultH4TextBlockStyle"
         BasedOn="{StaticResource DefaultBodyTextBlockStyle}"
         TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource MarkdownH4FontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="DefaultH5TextBlockStyle"
         BasedOn="{StaticResource DefaultBodyTextBlockStyle}"
         TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource MarkdownH5FontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="DefaultH6TextBlockStyle"
         BasedOn="{StaticResource DefaultBodyTextBlockStyle}"
         TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource MarkdownH6FontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="DefaultCodeTextBlockStyle"
         BasedOn="{StaticResource DefaultBodyTextBlockStyle}"
         TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MarkdownCodeFontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DefaultCodeInlineBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MarkdownCodeBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MarkdownCodeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="4,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DefaultCodeBlockBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MarkdownCodeBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Margin" Value="16,8,8,8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="DefaultTableHeaderTextBlockStyle"
         BasedOn="{StaticResource DefaultBodyTextBlockStyle}"
         TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource MarkdownTableHeaderForeground}" />
    </Style>

    <Style x:Key="DefaultTableCellGridStyle" TargetType="Grid">
        <Setter Property="BorderBrush" Value="{ThemeResource MarkdownTableBorderBrush}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="DefaultTableHeaderCellGridStyle"
         BasedOn="{StaticResource DefaultTableCellGridStyle}"
         TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource MarkdownTableHeaderBackground}" />
    </Style>

    <Style x:Key="AltTableCellGridStyle"
         BasedOn="{StaticResource DefaultTableCellGridStyle}"
         TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource MarkdownTableAltBackground}" />
    </Style>

    <Style x:Key="DefaultThematicBreakBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MarkdownThematicBreakBrush}" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Height" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Width" Value="500" />
    </Style>

    <Style x:Key="DefaultAddressBlockTextBlockStyle"
         BasedOn="{StaticResource DefaultBodyTextBlockStyle}"
         TargetType="TextBlock">
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

</ResourceDictionary>
