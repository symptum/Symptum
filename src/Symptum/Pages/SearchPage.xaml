<local:NavigablePage x:Class="Symptum.Pages.SearchPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="using:Symptum.Helpers"
  xmlns:local="using:Symptum.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="using:Symptum.Models"
  xmlns:vm="using:Symptum.ViewModels"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  mc:Ignorable="d">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" x:Name="rootGrid">
    <AutoSuggestBox x:Name="searchBox"
                    PlaceholderText="Type to search..."
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged"
                    QuerySubmitted="SearchBox_QuerySubmitted" />
    <controls:WrapPanel Grid.Row="1" HorizontalSpacing="12" VerticalSpacing="12">
      <CheckBox Content="Include content"
                IsChecked="{x:Bind ViewModel.SearchContent, Mode=TwoWay}" />
      <CheckBox Content="Include metadata"
                IsChecked="{x:Bind ViewModel.SearchMetadata, Mode=TwoWay}" />
      <CheckBox Content="Match case"
                IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}" />
      <ComboBox Grid.Column="1"
                MinWidth="160"
                ItemsSource="{x:Bind ViewModel.ScopeOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedScope, Mode=TwoWay}" />
    </controls:WrapPanel>
    <ProgressRing Grid.Row="2"
                  IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <TextBlock Margin="0,12,0,4"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Style="{ThemeResource CaptionTextBlockStyle}"
                 Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
      <ListView Grid.Row="1"
                IsItemClickEnabled="True"
                ItemClick="ResultsLV_ItemClick"
                ItemsSource="{x:Bind ViewModel.Results}"
                SelectionMode="Single">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="models:SearchResult">
            <Grid Padding="12,8"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="2">
              <FontIcon Grid.RowSpan="3"
                        FontSize="20"
                        Glyph="{x:Bind helpers:SearchResultFormatter.GetGlyph(Kind)}" />
              <TextBlock Grid.Column="1"
                         Style="{ThemeResource BodyStrongTextBlockStyle}"
                         Text="{x:Bind Title}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         MaxLines="1"
                         Style="{ThemeResource CaptionTextBlockStyle}"
                         Text="{x:Bind helpers:SearchResultFormatter.GetBreadcrumb(Breadcrumb)}"
                         TextTrimming="CharacterEllipsis" />
              <ItemsControl Grid.Row="2"
                            Grid.Column="1"
                            ItemsSource="{x:Bind Snippets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:SearchSnippet">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 Style="{ThemeResource CaptionTextBlockStyle}"
                                 Text="{x:Bind Field}" />
                      <TextBlock Margin="6,0,0,0"
                                 Style="{ThemeResource CaptionTextBlockStyle}"
                                 Text=": " />
                      <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind Pre}" />
                      <TextBlock FontWeight="Bold"
                                 Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                 Style="{ThemeResource CaptionTextBlockStyle}"
                                 Text="{x:Bind Match}" />
                      <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind Post}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</local:NavigablePage>
