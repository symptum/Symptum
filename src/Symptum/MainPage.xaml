<Page x:Class="Symptum.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Symptum"
      xmlns:nav="using:Symptum.Navigation"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <win:TitleBar x:Name="titleBar"
                  IsPaneToggleButtonVisible="True"
                  IsBackButtonVisible="{x:Bind contentFrame.CanGoBack, Mode=OneWay}">
            <win:TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Images/Symptum.png" />
            </win:TitleBar.IconSource>
        </win:TitleBar>
        <NavigationView x:Name="navView"
                    Grid.Row="1"
                    IsBackButtonVisible="Visible"
                    IsTabStop="False"
                    MenuItemsSource="{x:Bind nav:NavigationManager.NavigationInfos}">
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="nav:NavigationInfo">
                    <NavigationViewItem Content="{x:Bind Title}"
                              MenuItemsSource="{Binding Children}"
                              Tag="{x:Bind}">
                        <NavigationViewItem.Icon>
                            <IconSourceElement IconSource="{x:Bind IconSource}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>
            <Frame x:Name="contentFrame"
                   IsTabStop="True" />
        </NavigationView>
    </Grid>
</Page>
