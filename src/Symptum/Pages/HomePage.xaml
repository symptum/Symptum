<local:NavigablePage x:Class="Symptum.Pages.HomePage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="using:Symptum.Pages"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:media="using:Microsoft.UI.Xaml.Media"
                     xmlns:nav="using:Symptum.Core.Management.Navigation"
                     xmlns:sub="using:Symptum.Core.Subjects"
                     xmlns:vm="using:Symptum.ViewModels"
                     mc:Ignorable="d">
  <ScrollViewer>
    <Grid RowDefinitions="380,*">
      <Grid x:Name="heroGrid">
        <Rectangle x:Name="hero" />
        <StackPanel x:Name="heroTitles"
                    Margin="36"
                    VerticalAlignment="Bottom"
                    Spacing="4">
          <TextBlock FontWeight="Bold"
                     Style="{ThemeResource TitleLargeTextBlockStyle}"
                     Text="Symptum" />
          <TextBlock Style="{ThemeResource BodyTextBlockStyle}"
                     Text="The Open-Source Medical Learning Platform"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <StackPanel x:Name="content"
                  Grid.Row="1"
                  Margin="{ThemeResource NavViewContentMargin}"
                  Spacing="36">
        <StackPanel Spacing="12">
          <TextBlock FontWeight="SemiBold"
                     Style="{ThemeResource SubtitleTextBlockStyle}"
                     Text="Favorites" />
          <ItemsRepeater x:Name="favorites">
            <ItemsRepeater.Layout>
              <UniformGridLayout ItemsStretch="Fill"
                                 MinColumnSpacing="12"
                                 MinItemWidth="200"
                                 MinRowSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="nav:INavigable">
                <Button Padding="16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Command="{x:Bind vm:MainViewModel.Instance.NavigateCommand}"
                        CommandParameter="{x:Bind}"
                        CornerRadius="12">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="36"
                            Height="36"
                            Background="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            CornerRadius="8">
                      <FontIcon HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE930;" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind Title}"
                               TextWrapping="Wrap" />
                    <!-- <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               MaxLines="2"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="Open Resource"
                               TextTrimming="WordEllipsis"
                               TextWrapping="WrapWholeWords" />-->
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock FontWeight="SemiBold"
                     Style="{ThemeResource SubtitleTextBlockStyle}"
                     Text="Subjects" />
          <ItemsRepeater x:Name="subjectGrid" ItemsSource="{x:Bind sub:SubjectsManager.Subjects}">
            <ItemsRepeater.Layout>
              <UniformGridLayout ItemsStretch="Fill"
                                 MinColumnSpacing="12"
                                 MinItemWidth="200"
                                 MinRowSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="sub:Subject">
                <Button Padding="16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Command="{x:Bind vm:MainViewModel.Instance.NavigateToUriCommand}"
                        CommandParameter="{x:Bind Uri}"
                        CornerRadius="12">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,*"
                        RowSpacing="4">
                    <Border Grid.RowSpan="2"
                            Width="36"
                            Height="36"
                            Background="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            CornerRadius="8">
                      <FontIcon HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE930;" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Text="{x:Bind Title}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               MaxLines="2"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Text="{x:Bind Description}"
                               TextTrimming="WordEllipsis"
                               TextWrapping="WrapWholeWords" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>
      </StackPanel>

      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="LayoutVisualStates">
          <VisualState x:Name="WideLayout">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="640" />
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="NarrowLayout">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="heroTitles.Margin" Value="16" />
              <Setter Target="content.Margin" Value="{ThemeResource NavViewContentNarrowMargin}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ScrollViewer>
</local:NavigablePage>
