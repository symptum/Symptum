<local:NavigablePage x:Class="Symptum.Pages.MarkdownPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="using:Symptum.Pages"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:md="using:Symptum.UI.Markdown"
                     mc:Ignorable="d">
  <Grid RowDefinitions="Auto,Auto,*">
    <TextBlock x:Name="titleTB"
               Style="{ThemeResource PageTitleTextBlockStyle}"
               Text="{x:Bind Navigable.Title}" />

    <Border Grid.Row="1"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="0">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ComboBox x:Name="fontCombo"
                  MinWidth="130"
                  SelectedIndex="0"
                  SelectionChanged="OnSettingChanged">
          <ComboBoxItem Content="System" />
          <ComboBoxItem Content="Serif" />
          <ComboBoxItem Content="Sans Serif" />
          <ComboBoxItem Content="Monospace" />
        </ComboBox>
        <ComboBox x:Name="sizeCombo"
                  MinWidth="80"
                  SelectedIndex="2"
                  SelectionChanged="OnSettingChanged">
          <ComboBoxItem Content="10" Tag="10" />
          <ComboBoxItem Content="12" Tag="12" />
          <ComboBoxItem Content="14" Tag="14" />
          <ComboBoxItem Content="16" Tag="16" />
          <ComboBoxItem Content="18" Tag="18" />
          <ComboBoxItem Content="20" Tag="20" />
        </ComboBox>
        <ComboBox x:Name="themeCombo"
                  MinWidth="120"
                  SelectedIndex="0"
                  SelectionChanged="OnThemeChanged">
          <ComboBoxItem Content="System" />
          <ComboBoxItem Content="Light" />
          <ComboBoxItem Content="Sepia" />
          <ComboBoxItem Content="Warm Light" />
          <ComboBoxItem Content="Dark" />
          <ComboBoxItem Content="Nord" />
          <ComboBoxItem Content="Dracula" />
          <ComboBoxItem Content="OLED Dark" />
        </ComboBox>
      </StackPanel>
    </Border>

    <md:MarkdownTextBlock x:Name="markdownView"
                          Grid.Row="2"
                          Background="{ThemeResource MarkdownBackgroundBrush}" />

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="LayoutVisualStates">
        <VisualState x:Name="WideLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="640" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="NarrowLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="titleTB.Margin" Value="{ThemeResource PageTitleTextBlockNarrowMargin}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</local:NavigablePage>
