<Page x:Class="Symptum.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Symptum"
      xmlns:nav="using:Symptum.Navigation"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:controls="using:Symptum.Controls"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid utu:SafeArea.Insets="All" RowDefinitions="Auto,*">
    <win:TitleBar x:Name="titleBar"
                  IsBackButtonVisible="{x:Bind contentFrame.CanGoBack, Mode=OneWay}"
                  IsPaneToggleButtonVisible="True">
      <win:TitleBar.IconSource>
        <ImageIconSource ImageSource="/Assets/Images/Symptum.png" />
      </win:TitleBar.IconSource>
    </win:TitleBar>
    <NavigationView x:Name="navView"
                    Grid.Row="1"
                    AlwaysShowHeader="False"
                    IsBackButtonVisible="Visible"
                    IsTabStop="False"
                    MenuItemsSource="{x:Bind nav:NavigationManager.NavigationInfos}">
      <NavigationView.MenuItemTemplate>
        <DataTemplate x:DataType="nav:NavigationInfo">
          <NavigationViewItem Content="{x:Bind Title}"
                              MenuItemsSource="{x:Bind Children}"
                              Tag="{x:Bind}">
            <NavigationViewItem.Icon>
              <IconSourceElement IconSource="{x:Bind IconSource}" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
        </DataTemplate>
      </NavigationView.MenuItemTemplate>
      <NavigationView.Header>
        <TextBlock x:Name="navViewTitleTB" Style="{ThemeResource NarrowPageTitleTextBlockStyle}" />
      </NavigationView.Header>
      <Frame x:Name="contentFrame" IsTabStop="True" />
    </NavigationView>
    <controls:FocusSessionBar x:Name="focusSessionBar" Grid.Row="1" Margin="8" Width="130"
                              VerticalAlignment="Bottom" HorizontalAlignment="Right" />
  </Grid>
</Page>
