<local:NavigablePage x:Class="Symptum.Pages.FocusSessionPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="using:Symptum.Pages"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:controls="using:CommunityToolkit.WinUI.Controls"
                     mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="titleTB"
               Grid.Row="0"
               Style="{ThemeResource PageTitleTextBlockStyle}"
               Text="Focus Session" />

    <Grid x:Name="content"
          Grid.Row="1"
          Margin="{ThemeResource NavViewContentMargin}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          RowSpacing="28"
          RowDefinitions="Auto,*,Auto">

      <controls:Segmented x:Name="modeSegmented"
                          HorizontalAlignment="Center"
                          SelectionChanged="ModeSegmented_SelectionChanged">
        <controls:SegmentedItem Content="Focus" />
        <controls:SegmentedItem Content="Short Break" />
        <controls:SegmentedItem Content="Long Break" />
      </controls:Segmented>

      <Grid x:Name="clockGrid"
            Grid.Row="1"
            MaxWidth="320"
            MaxHeight="320"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Ellipse x:Name="ringTrack"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0.35"
                 Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
        <Path x:Name="ringProgress"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stroke="{ThemeResource AccentFillColorDefaultBrush}"
              StrokeEndLineCap="Round"
              StrokeStartLineCap="Round" />
        <TextBlock x:Name="timeTB"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{ThemeResource MarkdownCodeFontFamily}"
                   FontSize="64"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                   Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" />
      </Grid>

      <StackPanel HorizontalAlignment="Center"
                  Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="28">
        <Button x:Name="resetButton"
                Command="{x:Bind ViewModel.ResetCommand}"
                Style="{ThemeResource IconButtonStyle}"
                ToolTipService.ToolTip="Reset">
          <FontIcon FontSize="14" Glyph="&#xE72C;" />
        </Button>
        <Button x:Name="playButton"
                Width="72"
                Height="72"
                Command="{x:Bind ViewModel.ToggleCommand}"
                CornerRadius="36"
                Style="{ThemeResource AccentButtonStyle}"
                ToolTipService.ToolTip="Start / Pause">
          <FontIcon x:Name="playIcon"
                    FontSize="26"
                    Glyph="&#xE768;" />
        </Button>
        <Button x:Name="skipButton"
                Command="{x:Bind ViewModel.SkipCommand}"
                Style="{ThemeResource IconButtonStyle}"
                ToolTipService.ToolTip="Skip">
          <FontIcon FontSize="14" Glyph="&#xE893;" />
        </Button>
      </StackPanel>
    </Grid>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="LayoutVisualStates">
        <VisualState x:Name="WideLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="640" MinWindowHeight="560" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="NarrowLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="360" MinWindowHeight="360" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="titleTB.Visibility" Value="Collapsed" />
            <Setter Target="content.Margin" Value="{ThemeResource NavViewContentNarrowMargin}" />
            <Setter Target="clockGrid.MaxWidth" Value="260" />
            <Setter Target="clockGrid.MaxHeight" Value="260" />
            <Setter Target="timeTB.FontSize" Value="24" />
            <Setter Target="content.RowSpacing" Value="16" />
            <Setter Target="playButton.Width" Value="48" />
            <Setter Target="playButton.Height" Value="48" />
            <Setter Target="playButton.Padding" Value="8" />
            <Setter Target="playButton.CornerRadius" Value="24" />
            <Setter Target="playIcon.FontSize" Value="20" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="MinimalLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" MinWindowHeight="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="titleTB.Visibility" Value="Collapsed" />
            <Setter Target="content.Margin" Value="{ThemeResource NavViewContentNarrowMargin}" />
            <Setter Target="modeSegmented.Visibility" Value="Collapsed" />
            <Setter Target="clockGrid.MaxWidth" Value="180" />
            <Setter Target="clockGrid.MaxHeight" Value="180" />
            <Setter Target="timeTB.FontSize" Value="18" />
            <Setter Target="content.RowSpacing" Value="12" />
            <Setter Target="playButton.Width" Value="32" />
            <Setter Target="playButton.Height" Value="32" />
            <Setter Target="playButton.Padding" Value="4" />
            <Setter Target="playButton.CornerRadius" Value="16" />
            <Setter Target="playIcon.FontSize" Value="14" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</local:NavigablePage>
