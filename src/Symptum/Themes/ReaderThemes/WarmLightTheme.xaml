<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="MarkdownBackgroundBrush" Color="#FFFFFAF0" />
  <SolidColorBrush x:Key="MarkdownForegroundBrush" Color="#FF3C2415" />
  <SolidColorBrush x:Key="MarkdownAccentBrush" Color="#FFB85C1A" />
  <SolidColorBrush x:Key="MarkdownH1Foreground" Color="#FFB85C1A" />
  <SolidColorBrush x:Key="MarkdownCodeBackground" Color="#FFF5EDE0" />
  <SolidColorBrush x:Key="MarkdownCodeBorderBrush" Color="#FFD4C4A0" />
  <SolidColorBrush x:Key="MarkdownTableHeaderBackground" Color="#FFB85C1A" />
