<local:NavigablePage x:Class="Symptum.Pages.DefaultPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="using:Symptum.Pages"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:nav="using:Symptum.Core.Management.Navigation"
                     xmlns:vm="using:Symptum.ViewModels"
                     mc:Ignorable="d">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ItemsRepeater x:Name="repeater" Margin="{ThemeResource NavViewContentMargin}">
      <ItemsRepeater.Layout>
        <UniformGridLayout ItemsStretch="Fill"
                           MinColumnSpacing="12"
                           MinItemHeight="100"
                           MinItemWidth="200"
                           MinRowSpacing="12" />
      </ItemsRepeater.Layout>
      <ItemsRepeater.ItemTemplate>
        <DataTemplate x:DataType="nav:INavigable">
          <Button Padding="16"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Command="{x:Bind vm:MainViewModel.Instance.NavigateCommand}"
                  CommandParameter="{x:Bind}"
                  CornerRadius="12">
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Text="{x:Bind Title}"
                       TextWrapping="WrapWholeWords" />
          </Button>
        </DataTemplate>
      </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
  </ScrollViewer>
</local:NavigablePage>
